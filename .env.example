# SMTP — CSR Pipeline
# Ganti dengan kredensial email pengirim yang valid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
FROM_ADDR=admin@ypsma.org
FROM_NAME="YPSMA - Yayasan Pendidikan dan Sosial Ma'arif"

# Meta Pixel (CF env var) / Conversions API (set META_ACCESS_TOKEN as CF Secret)
META_PIXEL_ID=your-meta-pixel-id
# META_ACCESS_TOKEN=<get from Meta Events Manager, set as CF Secret>
